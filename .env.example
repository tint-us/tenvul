# Tenable Security Center hostname or IP address (include https://)
TENABLE_HOST=https://your-tenable-sc-host

# Tenable SC API port (default: 443)
TENABLE_PORT=443

# Tenable SC API credentials
# Generate these from: Tenable SC > Users > Your Profile > API Keys
ACCESS_KEY=your_access_key_here
SECRET_KEY=your_secret_key_here

# Port for this web app (default: 3000)
PORT=3000
